# LovingVoice Environment Variables Example
# Copy this file to .env and replace every placeholder before production.

APP_ENV=development

# OpenAI Realtime Translation
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_REALTIME_MODEL=gpt-realtime-translate

# Gemini API Key (legacy/fallback path)
GEMINI_API_KEY=replace-me

# Gemini Live API Key (optional)
GEMINI_LIVE_API_KEY=replace-me

# Google Cloud Application Credentials (legacy/fallback path)
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json

# Transitional speaker password path. There is no built-in default anymore.
# Prefer room-scoped host tokens and remove this compatibility path after migration.
SPEAKER_PASSWORD=replace-with-a-strong-password

# Long random value used to sign room-scoped host tokens.
# Generate separately for production and never expose it to the browser.
ROOM_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Recent captions sent to late joiners. All limits apply together.
SUBTITLE_HISTORY_LIMIT=30
SUBTITLE_HISTORY_MAX_AGE_SECONDS=300
SUBTITLE_HISTORY_MAX_BYTES=32768
SUBTITLE_HISTORY_ITEM_MAX_CHARS=2000

# Planned LovingVoice Universal rollout flags. Keep disabled until the
# entitlement, atomic quota, rate-limit, and short-lived client-secret path exists.
FEATURE_UNIVERSAL_TRANSLATION=false
FEATURE_DIRECT_WEBRTC_TRANSLATION=false
FEATURE_SCREEN_MEDIA_TRANSLATION=false
FEATURE_PERSISTENT_ROOMS=false
