# LovingVoice Environment Variables Example
# Copy this file to .env and fill in your actual API keys.

# Gemini API Key (Gemini 2.5 Flash)
GEMINI_API_KEY=AIzaSy...

# Gemini Live API Key (Optional)
GEMINI_LIVE_API_KEY=AQ....

# Google Cloud Application Credentials (Service Account JSON Path)
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json

# Long random value used to sign room-scoped host tokens.
# Generate separately for production and never expose it to the browser.
ROOM_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Recent captions sent to late joiners. All limits apply together.
SUBTITLE_HISTORY_LIMIT=30
SUBTITLE_HISTORY_MAX_AGE_SECONDS=300
SUBTITLE_HISTORY_MAX_BYTES=32768
SUBTITLE_HISTORY_ITEM_MAX_CHARS=2000

# OpenAI Realtime Translate (preferred engine)
OPENAI_API_KEY=sk-proj-...
OPENAI_REALTIME_MODEL=gpt-realtime-translate

# Ultra-low-latency safeguards. Older audio is discarded instead of replayed late.
OPENAI_REALTIME_AUDIO_BACKLOG_MS=400
REALTIME_FANOUT_QUEUE_SIZE=8
REALTIME_SEND_TIMEOUT_SECONDS=0.35
